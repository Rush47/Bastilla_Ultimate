# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local runtime (Node.js 22.18+ and Python 3).
PORT=3000
BASTILLA_HOST="127.0.0.1"
# Remote hosting requires BASTILLA_HOST=0.0.0.0 and a long random
# BASTILLA_API_TOKEN configured in server secrets. Do not commit its value.
# BASTILLA_API_TOKEN=
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2-vision:11b"
GEMINI_MODEL="gemini-flash-latest"
# Queue provider: ollama or gemini. Jobs do not silently switch providers.
BASTILLA_AGENT_PROVIDER="ollama"
# BASTILLA_DB_PATH="/absolute/path/to/bastilla.db"
# Without an override, an existing /var/lib/bastilla/bastilla.db is retained;
# otherwise the app initializes .bastilla/bastilla.db inside the project.

# Host provisioning and background host operations are opt-in.
BASTILLA_PROVISION_HOST=false
BASTILLA_ROOT_SOCKET=false
BASTILLA_CONTINUOUS_MISSION=false
# Optional Gemini compatibility adapter (not a local Ollama daemon).
# It advertises no weights and requires GEMINI_API_KEY for inference.
BASTILLA_OLLAMA_BRIDGE=false
BASTILLA_BRIDGE_PORT=11435

# Codex CLI is installed locally with the project dependencies.
# Configure OPENAI_API_KEY in server secrets to enable API-key login.
# Without a key, use "Zaloguj przez ChatGPT" in the panel.
# Existing CODEX_HOME and Codex credential-store configuration are respected.
# BASTILLA_CODEX_BIN="/absolute/path/to/codex"
