#!/usr/bin/env python3
import sys

args = sys.argv[1:]
if "--list" in args:
    # return the first option id or text
    print("1")
    sys.exit(0)
elif "--info" in args or "--text-info" in args:
    # read stdin if piped
    if not sys.stdin.isatty():
        data = sys.stdin.read()
        if data:
            print(data)
    print("[Zenity UI: OK]")
    sys.exit(0)
else:
    print("[Zenity GUI Active]")
    sys.exit(0)
